{
  "workspace": ".",
  "reports_dir": "reports",
  "state_file": ".rocm-doctor-state.json",
  "active_profile": "fake-openai",
  "model": {
    "name": "fake-qwen3",
    "base_url": "http://127.0.0.1:8000/v1",
    "expected_base_url": "http://127.0.0.1:8000/v1",
    "wrong_base_url": "http://127.0.0.1:8001/v1",
    "max_model_len": 2048,
    "safe_max_model_len": 4096,
    "tool_parser": "qwen3",
    "expected_tool_parser": "qwen3",
    "tool_check_enabled": true
  },
  "launch": {
    "device_flags": ["/dev/kfd", "/dev/dri"],
    "required_device_flags": ["/dev/kfd", "/dev/dri"]
  },
  "service": {
    "name": "fake-vllm",
    "restart_count": 0,
    "restart_mode": "dry-run"
  },
  "provider": {
    "fake": {
      "mode": "normal"
    }
  },
  "profiles": {
    "fake-openai": {
      "id": "fake-openai",
      "runtime_type": "fake",
      "endpoint_protocol": "openai-compatible",
      "model_name": "fake-qwen3",
      "capabilities": {
        "models": true,
        "chat_completions": true,
        "tool_calls": true,
        "context_length": true,
        "rocm_device_flags": true,
        "restart": true
      },
      "context": {
        "safe_max_model_len": 4096
      },
      "request_timeout_seconds": 1.5,
      "tool_calling": {
        "expected_parser": "qwen3"
      },
      "health_probes": [
        "endpoint_models",
        "chat_completion",
        "context_length",
        "rocm_device_flags",
        "tool_call_parser"
      ],
      "known_failure_signatures": {
        "wrong_endpoint_port": [
          "GET /v1/models failed",
          "configured URL differs from expected URL"
        ],
        "context_length_too_large": [
          "max_model_len exceeds safe_max_model_len"
        ],
        "tool_parser_mismatch": [
          "response did not contain a tool call"
        ],
        "missing_rocm_device_flags": [
          "missing ROCm device flags"
        ]
      },
      "safe_repair_recipes": [
        "noop",
        "update_endpoint_url",
        "lower_max_model_len",
        "set_tool_parser",
        "set_rocm_device_flags",
        "restart_known_service"
      ],
      "skip_reasons": {}
    }
  }
}
